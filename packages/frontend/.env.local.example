MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/dechat?retryWrites=true&w=majority
MONGODB_DB_NAME=dechat
BETTER_AUTH_SECRET=replace-with-32-char-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3001
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password
EMAIL_FROM="dechat <noreply@example.com>"
NODE_ENV=development
SESSION_CACHE_TTL_MS=30000
KICKOUT_CACHE_TTL_MS=10000
ADMIN_INDEX_KEY=dev-index-key

# Cloudflare R2 (E2EE media file storage)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dechat-media
R2_ACCOUNT_ID=
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
